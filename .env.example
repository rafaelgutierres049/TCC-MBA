# =============================================================
# AgenticML — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# =============================================================

# --- LLM: OpenAI ---
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Modelo OpenAI a usar (padrão: gpt-4o)
OPENAI_MODEL=gpt-4o

# --- LLM: Anthropic ---
# Obtenha sua chave em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Anthropic a usar (padrão: claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Provedor primário ---
# Qual LLM usar por padrão: "openai" ou "anthropic"
PRIMARY_LLM=openai

# --- Limites do pipeline ---
# Tamanho máximo do arquivo em MB (padrão: 50)
MAX_FILE_SIZE_MB=50

# Máximo de linhas para preview (padrão: 10000)
MAX_ROWS_PREVIEW=10000

# Temperatura dos LLMs — 0.0 para reprodutibilidade (não alterar para TCC)
LLM_TEMPERATURE=0.0

# Máximo de tokens por resposta LLM
LLM_MAX_TOKENS=4096
